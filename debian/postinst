#!/bin/bash
set -e

# ghdeb postinst 脚本 - root 权限执行
# 核心原则：所有目录和文件必须显式设置 root:root，不依赖 dpkg 提取时的所有权

# 使用 install -d 原子创建目录（同时设置 owner/group/mode）
install -d -m 755 -o root -g root /etc/ghdeb
install -d -m 755 -o root -g root /var/cache/ghdeb
install -d -m 755 -o root -g root /usr/share/ghdeb/hooks

# 强制修正目录所有权（防止 dpkg 提取时带入错误 GID）
chown root:root /etc/ghdeb
chown root:root /var/cache/ghdeb

# 状态文件（root 写，其他只读）
if [ ! -f /var/cache/ghdeb/installed.json ]; then
    echo '{"packages":{}}' > /var/cache/ghdeb/installed.json
fi
chown root:root /var/cache/ghdeb/installed.json
chmod 644 /var/cache/ghdeb/installed.json

# catalog.toml 由 ghdeb 生成，非包内文件。
# 初次安装：不存在 → 由 `ghdeb catalog init` 自动生成
# 后续升级：已存在 → 不覆盖，仅修正所有权
if [ -f /etc/ghdeb/catalog.toml ]; then
    chown root:root /etc/ghdeb/catalog.toml
    chmod 644 /etc/ghdeb/catalog.toml
    echo "   catalog.toml 已存在，升级不覆盖"
else
    # 注：postinst 在 dpkg 提取二进制后执行，/usr/bin/ghdeb 已可用
    # 首次调用 init 时 catalog.toml 尚不存在，不会触发覆盖确认
    # 失败不阻断安装（如无网络时），仅打印提示
    if command -v ghdeb >/dev/null 2>&1; then
        if ghdeb catalog init >/dev/null 2>&1; then
            echo "   catalog.toml 已通过 ghdeb catalog init 自动生成"
        else
            echo "   ⚠️  catalog init 未能完成（可能无网络），未生成 catalog.toml"
        fi
    else
        echo "   ⚠️  未找到 ghdeb 二进制，跳过 catalog init"
    fi
fi

# 迁移旧状态文件（从用户目录迁移到系统目录）
for home_dir in /home/*; do
    OLD_STATE="$home_dir/.local/state/ghdeb/installed.json"
    if [ -f "$OLD_STATE" ] && [ ! -s /var/cache/ghdeb/installed.json ]; then
        cp "$OLD_STATE" /var/cache/ghdeb/installed.json
        chown root:root /var/cache/ghdeb/installed.json
        chmod 644 /var/cache/ghdeb/installed.json
        echo "   已迁移状态文件: $OLD_STATE"
        break
    fi
done

# dpkg hook：监控软件包卸载
# 注意：使用 || true 确保脚本不存在时不报错（purge 期间脚本可能已被删除）
cat > /etc/apt/apt.conf.d/99ghdeb-hook << 'HOOK_EOF'
Dpkg::Post-Invoke { "test -x /usr/share/ghdeb/hooks/remove-monitor.sh && /usr/share/ghdeb/hooks/remove-monitor.sh || true"; };
HOOK_EOF

echo "✅ ghdeb 安装完成"
echo "   配置路径: /etc/ghdeb/catalog.toml"
echo "   状态文件: /var/cache/ghdeb/installed.json"
echo "   已安装 dpkg hook 用于自动跟踪包状态"

exit 0
